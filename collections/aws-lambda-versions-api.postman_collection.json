          "name": "Aws Lambda Publish a Version",
          "request": {
            "name": "Aws Lambda Publish a Version",
            "description": {
              "content": "Creates a version from the current code and configuration of a function. Use versions to create a snapshot of your function code and configuration that does not change. Lambda does not publish a version if the function's configuration and code have not changed since the last version.",
              "type": "text/plain"
            },
            "url": {
